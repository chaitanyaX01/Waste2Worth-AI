# Environment Variables for Waste2Worth AI
PROJECT_NAME="Waste2Worth AI"
API_V1_PREFIX="/api"

# Production PostgreSQL Database
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/waste2worth"

# Security & Authentication
SECRET_KEY="waste2worth-super-secret-key-change-in-production-competition-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Files
MODEL_PATH="/Users/chaitanya/Desktop/Waste2Worth_AI/waste2worth_resnet18.pth"
CLASS_NAMES_PATH="/Users/chaitanya/Desktop/Waste2Worth_AI/class_names.json"

# File Uploads Directory
UPLOAD_DIR="/Users/chaitanya/Desktop/Waste2Worth_AI/backend/uploads"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Persistent Public Tunnel Configuration
# Default fixed subdomain (produces https://waste2worth-live.loca.lt)
TUNNEL_SUBDOMAIN="waste2worth-live"

# Optional: Permanent Ngrok static domain (get free at ngrok.com)
# NGROK_DOMAIN="waste2worth-ai.ngrok-free.app"

# Optional: Cloudflare Named Tunnel Token
# CLOUDFLARE_TUNNEL_TOKEN=""

