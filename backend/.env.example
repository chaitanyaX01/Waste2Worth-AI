# Waste2Worth AI Configuration
PROJECT_NAME="Waste2Worth AI"
API_V1_PREFIX="/api"

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:password@localhost:5432/waste2worth"

# Authentication & Security
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration
MODEL_PATH="/path/to/Waste2Worth_AI/waste2worth_resnet18.pth"
CLASS_NAMES_PATH="/path/to/Waste2Worth_AI/class_names.json"

# File Upload Directory
UPLOAD_DIR="/path/to/Waste2Worth_AI/backend/uploads"

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
